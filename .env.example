DISCORD_BOT_TOKEN=your_env_here         # discord bot token
GOOGLE_GEMINI_TOKEN=your_env_here       # Google Gemini AI Studio API key
GEMINI_MODEL=your_env_here              # Gemini Model's name to be used

LOG_CHANNEL_ID=your_env_here            # Channel id to send logs to
OWNER_ID=your_env_here                  # Your (developer) discord id
LOG_DMS=on                              # on or off     

REPLY_DELAYS=on                         # on or off
IDLE_AFTER_MIN=10                       # minutes without activity before going idle
PRESENCE_MODE=all                       # "all" = any message the bot can see; "mentions" = only DMs and @mentions